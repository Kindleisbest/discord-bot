# Copy this file to .env. Never upload .env or put secrets in Discord/chat.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data

# Optional Instagram link processing. Keep false until you have enabled Discord's
# Message Content privileged intent in the Developer Portal. Restart after changing.
# Each server also needs its own explicit enable switch in the Instagram page.
INSTAGRAM_LINKS_ENABLED=false

# Discord Developer Portal > your application > General Information
DISCORD_CLIENT_ID=REPLACE_WITH_DISCORD_APPLICATION_ID
# Discord Developer Portal > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=REPLACE_WITH_DISCORD_OAUTH_CLIENT_SECRET
# Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_BASE64_32_BYTE_KEY

# Register the exact redirect: http://127.0.0.1:3000/auth/callback
# For public deployment, use NODE_ENV=production and an HTTPS APP_ORIGIN.
# Public hosting will be finalized in the deployment stage. Do not port-forward the Pi.
